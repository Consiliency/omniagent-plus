{
  "name": "omniagent-plus",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.guard.json",
    "test": "node scripts/verify.mjs test",
    "test:guard": "node scripts/verify.mjs test:guard",
    "test:integration": "node scripts/verify.mjs test:integration",
    "verify": "node scripts/verify.mjs verify"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^24.0.13",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "eslint": "^9.30.1",
    "globals": "^15.8.0",
    "typescript": "^5.8.3",
    "vite-node": "3.2.4",
    "vitest": "^3.2.4",
    "yaml": "2.8.1"
  }
}
