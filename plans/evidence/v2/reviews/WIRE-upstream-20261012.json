  "source_review": [
    {
      "paths": [
        "omnigent/entities/conversation.py",
        "omnigent/server/schemas.py"
      ],
      "finding": "MessageData adds optional user_authored/subagent_return_id; FunctionCallOutputData adds optional subagent_return_id. Required properties unchanged. UpdateSessionRequest adds default-false delete_worktree and ServerInfoResponse adds archive_worktree_cleanup. No local approval authority follows from these fields."
    },
    {
      "paths": [
        "omnigent/server/routes/sessions/routes_core.py"
      ],
      "finding": "switch-agent removed; current local HTTP client does not invoke it. Create now validates harness readiness before persistence. PATCH delete_worktree requires archived=true. These are v0.17 behavior changes, not compatibility proof from unchanged path signatures."
    },
    {
      "paths": [
        "omnigent/server/routes/sessions/routes_events.py",
        "omnigent/runtime/inflight_text.py"
      ],
      "finding": "Stream response adds X-Omnigent-Stream-Epoch tied to process-local preview state. Event dispatch resolves fresh runner binding and may raise wrong_replica. Do not retry uncertain mutations automatically; v0.17 epoch/recovery behavior needs its own future policy qualification."
    },
    {
      "paths": [
        "omnigent/server/routes/_sessions/helpers.py",
        "omnigent/cli.py",
        "omnigent/runtime/session_stream.py"
      ],
      "finding": "v0.17 suppresses data:[DONE] on server shutdown while normal close retains it. Restart remains a transport loss with snapshot/live-tail recovery; queue bound/overflow is not durable replay. Default v0.12 and optional v0.15/v0.16 remain frozen, and v0.17 support is not claimed."
    }
  ],
