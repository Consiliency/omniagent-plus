  "version": "0.6.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Consiliency/omniagent-plus.git",
    "directory": "packages/omnigent-transport"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
